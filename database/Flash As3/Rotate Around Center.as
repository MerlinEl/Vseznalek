public function rotateAroundCenter(object:DisplayObject, angleDegrees:Number):void {    if (object.rotation == angleDegrees) {        return;    }            var matrix:Matrix = object.transform.matrix;    var rect:Rectangle = object.getBounds(object.parent);    var centerX = rect.left + (rect.width / 2);    var centerY = rect.top + (rect.height / 2);    matrix.translate(-centerX, -centerY);    matrix.rotate((angleDegrees / 180) * Math.PI);    matrix.translate(centerX, centerY);    object.transform.matrix = matrix;        object.rotation = Math.round(object.rotation);}    