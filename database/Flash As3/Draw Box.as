			var rectangle:Shape = new Shape; // initializing the variable named rectangle			rectangle.graphics.beginFill(0xFF0000); // choosing the colour for the fill, here it is red			rectangle.graphics.drawRect(0, 0, tf.width,tf.height); // (x spacing, y spacing, width, height)			rectangle.graphics.endFill(); // not always needed but I like to put it in to end the fill			scroll_box_01.addChild(rectangle); // adds the rectangle to the stage