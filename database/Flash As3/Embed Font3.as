//https://tournasdimitrios1.wordpress.com/2010/09/22/the-basics-of-using-css-in-as3/import flash.text.TextField;import orien.tools.mcText;import flash.text.TextFormat;import fl.text.TLFTextField;import flash.text.AntiAliasType;import flash.text.GridFitType;import flash.text.StyleSheet;import flash.text.TextFieldAutoSize;import flash.text.TextFieldType;// superscript, subscript (BaselineShift.SUPERSCRIPT, BaselineShift.SUBSCRIPT, FormatValue.INHERIT.)import flashx.textLayout.formats.BaselineShift;// FontWeight.NORMAL, FontWeight.BOLD, FormatValue.INHERITimport flash.text.engine.FontWeight;//FontPosture.NORMAL, FontPosture.ITALIC, FormatValue.INHERIT.import flash.text.engine.FontPosture;//TextDecoration.NONE, TextDecoration.UNDERLINE, FormatValue.INHERIT.import flashx.textLayout.formats.TextDecoration;// Embed a system font/*[Embed(systemFont="Times New Roman", 	fontName = "times", 	mimeType = "application/x-font", 	fontWeight="bold", 	fontStyle="italic", 	advancedAntiAliasing="true", 	embedAsCFF="false")]var timesBoldItalic:Class;*/[Embed(source="../fonts/Times_New_Roman.ttf", fontName="times", mimeType="application/x-font-truetype")]const timesTTF:String;[Embed(source="../fonts/Times_New_Roman_Bold.ttf", fontName="times", fontWeight="bold", mimeType="application/x-font-truetype")]const timesBoldTTF:String;[Embed(source="../fonts/Times_New_Roman_Italic.ttf", fontName="times", fontStyle="italic", mimeType="application/x-font-truetype")]const timesItalicTTF:String;[Embed(source="../fonts/Times_New_Roman_Bold_Italic.ttf", fontName="times", fontWeight="bold", fontStyle="italic", mimeType="application/x-font-truetype")]const timesBoldItalicTTF:String;var txt = "<span class='defaultStyle'><b>Bold<b/></span> <span class='defaultStyle'><i>italic<i/></span> "txt += "<span class='defaultStyle'><u>Undeline text</u></span> Simple Text"txt += "FeOH<span class='sup'>3</span> FeOH<span class='sub'>3</span> "txt += "[ <span class='green'>GREEN</span>, <span class='red'>RED</span>, <span class='blue'>BLUE</span> ] "txt += "<span class='defaultStyle'>My <b>bold</b> text</span> ";txt += "<span class='defaultStyle'>My <i>italic</i> text</span>";trace(txt)my_txt_x.htmlText = txt;//trace(my_txt_x.htmlText)//my_txt_x.htmlText = html_txt;my_txt_x.antiAliasType = AntiAliasType.ADVANCED;my_txt_x.gridFitType = GridFitType.PIXEL;my_txt_x.sharpness = -200;my_txt_x.type = TextFieldType.DYNAMIC;my_txt_x.selectable = false;my_txt_x.multiline = true;my_txt_x.embedFonts = true;//my_txt_x.fontFamily = "times";my_txt_x.styleSheet = createStyleSheet("times", 35,  "#000000", "left"); 	/** * Create stles for TLFTextField * font_style_a = mcText.createStyleSheet("Times New Roman", 20, #4B479E, TextLayoutFormat.H_LEFT); */static public function createStyleSheet(family:String, size:int, clr:string, align:String):StyleSheet {    			var css:StyleSheet = new StyleSheet();			css.setStyle(".default", { 				 fontFamily: family, 				 fontSize: size, 				 color: clr			});			css.setStyle(".red", { 				 fontFamily: family, 				 fontSize: size, 				 color: "#ff0000"			});			css.setStyle(".green", { 				 fontFamily: family, 				 fontSize: size, 				 color: "#00ff00"			});			css.setStyle(".blue", { 				 fontFamily: family, 				 fontSize: size, 				 color: "#0000ff"			});			css.setStyle("p", {				fontFamily: family,				fontSize: size,				color: clr,				textAlign: align			});			css.setStyle(".sup", { 				baselineShift: BaselineShift.SUPERSCRIPT, 				fontFamily: family, 				fontSize: size, 				color: clr			});			css.setStyle(".sub", { 				baselineShift: BaselineShift.SUBSCRIPT, 				fontFamily: family, 				fontSize: size, 				color: clr			});			//textAlign left , center , right , and justify .			return css;		}mcText.showEmbeddedFonts();