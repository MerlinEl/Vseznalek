var str_arr = ["Banana", "Orange", "Lemon", "Apple", "", "Mango", "", "", ""];function trimStringArrayFromRight(arr:Array):Array {		var end_index:int = arr.length - 1; // last index of array	if (arr[end_index].length == 0) { // check if last rows is empty				var is_empty:Boolean = true;		while (is_empty) {						var str:String = arr[end_index - 1];			is_empty = str.length == 0			if (is_empty) end_index--;		}		arr = arr.slice(0, end_index); // cut last part of array	}	return arr;}trace(trimStringArrayFromRight(str_arr))// out: Banana,Orange,Lemon,Apple,,Mango