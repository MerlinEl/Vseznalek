[Embed(source="../fonts/Verdana.ttf", fontName="Verdana", mimeType="application/x-font-truetype")]const VerdanaTTF:String;[Embed(source="../fonts/Verdana_Bold.ttf", fontName="Verdana", fontWeight="bold", mimeType="application/x-font-truetype")]const VerdanaBoldTTF:String;[Embed(source="../fonts/Verdana_Italic.ttf", fontName="Verdana", fontStyle="italic", mimeType="application/x-font-truetype")]const VerdanaItalicTTF:String;[Embed(source="../fonts/Verdana_Bold_Italic.ttf", fontName="Verdana", fontWeight="bold", fontStyle="italic", mimeType="application/x-font-truetype")]const VerdanaBoldItalicTTF:String;var style:StyleSheet = new StyleSheet();style.setStyle(".defaultStyle", { 	 fontFamily: "Verdana", 	 fontSize: 45, 	 color: "#ff0000" });var t:TLFTextField = new TLFTextField();t.antiAliasType = AntiAliasType.ADVANCED;t.gridFitType = GridFitType.PIXEL;t.sharpness = -200;t.type = TextFieldType.DYNAMIC;t.selectable = false;t.multiline = true;t.embedFonts = true;t.styleSheet = style;t.htmlText = "<p><span class='defaultStyle'>My <b>bold</b> text</span>";t.htmlText += "<span class='defaultStyle'>My <i>italic</i> text</span></p>";addChild(t);