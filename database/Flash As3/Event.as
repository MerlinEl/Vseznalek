// MOUSE_MOVE is an expensive call. Event is fired multiple times per frameaddEventListener(MouseEvent.MOUSE_MOVE, onMove); 		private function onMove(e:MouseEvent) {			canvas_01.graphics.lineTo(mouseX, mouseY);		}// ENTER_FRAME ticks is 24 frames per secondaddEventListener(Event.ENTER_FRAME, onEnterFrame); 		private function onEnterFrame(e:Event):void{			canvas_01.graphics.lineTo(mouseX, mouseY);		} // TIMER fps can be regulatedprivate var timer:Timer = new Timer(50, 0);timer.addEventListener(TimerEvent.TIMER, paintTimer); 		private function paintTimer(e:TimerEvent):void {			canvas_01.graphics.lineTo(mouseX, mouseY);		}