ox>			    <label value="mov_"/> 			    <textbox id="edtText" value="card"/> 			    <textbox id="edtStart" value="1" width="20"/>			</hbox>			<hbox>			    <label value="Base Class:"/>			    <textbox id="baseClass" value="mcs.ClickCard"/>			</hbox>			<hbox>			    <label control="convertTo" value="Convert To:"/>			    <menulist id="convertTo" width="160"/> // onchange="setupLibPath()    			<menuitem label="MovieClip" value="mov" selected="true"/>    			<menuitem label="Graphics" value="gra"/>    			<menuitem label="Button" value="btn"/>			</hbox>			<hbox>			    <label value="Library Path:"/>			    <textbox id="libPath" value="mov"/>			</hbox>			<label control="lblPivotPos" value="Registration point:"/>			<listbox id="pivotPos" rows="9" width="160"> //oncreate="init()"				<listitem label="center" selected="true"/>				<listitem label="top left"/>				<listitem label="top right"/>				<listitem label="top center"/>				<listitem label="center left"/>				<listitem label="center right"/>				<listitem label="bottom left"/>				<listitem label="bottom center"/>				<listitem label="bottom right"/>			</listbox>		</vbox>		<script>			function initDialog(){fl.trace("init:")};			function setupLibPath(){fl.trace("setupLibPath")};		</script>	</dialog>			var xmlPanelOutput = showXMLPanel(xmlDialog.toString());	if (xmlPanelOutput.dismiss == "accept"){		var mc_name = xmlPanelOutput.edtText;		var pivot_pos = xmlPanelOutput.pivotPos;		var start_index = parseInt(xmlPanelOutput.edtStart);}	function showXMLPanel(xmlString){		var localConfigURI = fl.configURI;		fl.trace("uri:" + localConfigURI);		// Verify that the provided path ends with "/"		//if (localConfigURI.charAt(localConfigURI.length – 1) != "/") localConfigURI = localConfigURI + "/";		var path = localConfigURI + "Commands/.dialog-" + parseInt(Math.random() * 1000) + ".xml"		FLfile.write(path, xmlString);		var xmlPanelOutput = fl.getDocumentDOM().xmlPanel(path);		FLfile.remove(path);		return xmlPanelOutput;	}