//Guidelines From Selection by: DaveAtDog//https://github.com/DaveAtDog/Commands/blob/master/Guides%20-%20Add%20for%20selection(s).jsflfl.outputPanel.clear(); //clear consolevar doc = fl.getDocumentDOM();var sel  = doc.selection;if (doc != null && sel.length > 0) addGuidelinesToSelection();function addGuidelinesToSelection(){		var tl = doc.getTimeline();	// store original guide lines	var currentGuides = new XML(tl.getGuidelines());	// clear guides	tl.setGuidelines(new XML(<guidelines></guidelines>));	//fl.trace(currentGuides);	for (var i = 0; i < sel.length; i++){				var obj = sel[i];		var additionalGuides = new Array();		if (obj) {						additionalGuides.push('<guideline direction="v">' + obj.x + '</guideline>');			additionalGuides.push('<guideline direction="h">' + obj.y + '</guideline>');			additionalGuides.push('<guideline direction="v">' + (obj.x + obj.width) + '</guideline>');			additionalGuides.push('<guideline direction="h">' + (obj.y + obj.height) + '</guideline>');						for(var j = 0; j < additionalGuides.length; j++)			{				currentGuides.appendChild(new XML(additionalGuides[j]));			}		}		}	fl.trace(currentGuides);	tl.setGuidelines(new XML(currentGuides));}