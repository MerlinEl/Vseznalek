//just take first contour for testing. Can loop through "contours" array for the others eventuallyvar contour = fl.getDocumentDOM().getTimeline().layers[0].frames[0].elements[0].contours[0];var he = contour.getHalfEdge();var iStart = he.id;var id = 0;var points = [];while (id != iStart) {     points.unshift(he.getVertex());     if(he.getPrev().getEdge().id==he.getOppositeHalfEdge().getEdge().id) {          points.unshift(he.getPrev().getVertex());          break;     }     he = he.getPrev();     id = he.id;}he = contour.getHalfEdge();iStart = he.id;id = 0;while (id != iStart) {     points.push(he.getVertex());     if(he.getNext().getEdge().id==he.getOppositeHalfEdge().getEdge().id) {          break;     }     he = he.getNext();     id = he.id;}var startPoint = points[0];var endPoint = points[points.length-1];