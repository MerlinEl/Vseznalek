//Trace multiple layers at once(function () {        function collectAllRasterAndPlacedItems() {        var result = [];        var targets = ['rasterItems', 'placedItems']        for (var key of targets)            for (var i = 0; i < app.activeDocument[key].length; i++)                result.push(app.activeDocument[key][i])        return result;    }    var list = collectAllRasterAndPlacedItems();    for (var i = 0; i < list.length; i++)         if (list[i].trace) list[i].trace()}())