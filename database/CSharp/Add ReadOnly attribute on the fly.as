Solution 3 – Add ReadOnly attribute on the fly in the class implementation based on some criteriaSampleClassImplementation of the sample class should change:public class SampleClass:Component{    bool editable;    [RefreshProperties(RefreshProperties.All)]    public bool Editable    {        get { return editable; }        set        {            editable = value;            TypeDescriptor.GetProperties(this)["StringProperty"].SetReadOnlyAttribute(!editable);        }    }    string stringProperty;    [ReadOnly(true)]    public string StringProperty    {        get { return stringProperty; }        set        {            if (Editable)                stringProperty = value;        }    }}